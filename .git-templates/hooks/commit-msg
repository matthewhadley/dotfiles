#!/bin/bash
# commit-msg hook enforcing scopedcommits.com
#
#   <scope>: <description>
#
# Scope is the subsystem the commit touches -- the spec's point is that this is
# the highest-value thing in a log you are scanning. There is no type field:
# feat/fix/chore carry little information once every commit is prefixed by the
# area it changed.
#
# Accepted subject forms:
#   nvim: add the neo-tree dotfiles source
#   nvim, zsh: share one entry point                 comma-separated scopes
#   auth (PROJ-123): fix login bug                   ticket after the scope
#   net/http/cookiejar: add godoc links              paths are valid scopes
#   treewide: retab                                  for cross-cutting changes
#
# Optionally restrict the vocabulary per repo. Unset means any scope is
# allowed, which is the spec's default:
#
#   git config scopedcommits.scopes "api web infra docs treewide"

MSG=$(head -1 "$1" | tr -d '\r')

# An unedited message has no subject to check: quitting the editor leaves a
# blank first line above git's comment block. Git aborts that on its own, with
# a clearer error than this hook could give, so step aside rather than
# complaining about the format of something nobody typed. A real subject can
# never start with the comment char -- git would strip it.
if [[ -z ${MSG//[[:space:]]/} || $MSG == '#'* ]]; then
	exit 0
fi

# The spec exempts special commits: "reverts, merges, etc. can be formatted
# however you like".
if [[ $MSG =~ ^(Merge|Revert|fixup!|squash!|amend!) ]]; then
	exit 0
fi

# The root commit is exempt for the same reason -- there is no subsystem to
# name when the tree did not previously exist. rev-parse fails when HEAD has
# no commit behind it.
if ! git rev-parse --verify --quiet HEAD >/dev/null; then
	exit 0
fi

scope_re='[a-z0-9._/-]+'
# The description must contain something that is not whitespace -- ".+" alone
# accepts "app:   ", a commit with a scope and no message.
subject_re="^${scope_re}([[:space:]]*,[[:space:]]*${scope_re})*([[:space:]]\([A-Za-z0-9_-]+\))?:[[:space:]]+[^[:space:]].*$"

if ! [[ $MSG =~ $subject_re ]]; then
	echo "Rejected commit: message format"
	echo "  wanted:  <scope>: <description>"
	echo "  got:     $MSG"
	echo "  see:     scopedcommits.com"
	exit 1
fi

# Validate against the repo's vocabulary, if it declares one. --get-all so a
# multi-valued key reads as the whole list: --get would silently return only
# the last value, quietly shrinking the vocabulary to one entry.
allowed=$(git config --get-all scopedcommits.scopes | xargs)
if [[ -n $allowed ]]; then
	# Strip any " (TICKET)" then split the scope list on commas.
	scopes=${MSG%%:*}
	scopes=${scopes%% (*}
	IFS=',' read -ra parts <<<"$scopes"
	for raw in "${parts[@]}"; do
		s="${raw#"${raw%%[![:space:]]*}"}"
		s="${s%"${s##*[![:space:]]}"}"
		if ! [[ " $allowed " == *" $s "* ]]; then
			echo "Rejected commit: unknown scope '$s'"
			echo "  allowed: $allowed"
			echo "  add it:  git config scopedcommits.scopes \"$allowed $s\""
			exit 1
		fi
	done
fi
