brew "ripgrep"
brew "fd"
brew "tree-sitter-cli"
brew "git-lfs"
brew "herdr"
brew "yazi"

# yazi shells out to ffmpeg for video file previews (thumbnail extraction).
# Not a hard dependency -- yazi runs fine without it, previews just don't
# render for video files.
brew "ffmpeg"

# Required by .config/herdr/install-plugins.sh, which already hard-fails
# without it on PATH -- was relied on but never actually declared anywhere.
brew "jq"

# uvx (from uv) is what vjeantet.palette's scripts/check-compat.sh uses to
# validate commands.json against its schema -- install-plugins.sh runs that
# script every time and aborts (set -e) if neither uvx nor check-jsonschema
# is on PATH, which also skips the `herdr server reload-config` at the end.
brew "uv"

# Referenced by .zshrc.d/00.env.zsh for FPATH, same story as jq above.
brew "zsh-completions"

# bat's config and terafox theme are tracked under .config/bat/, but a theme in
# themes/ does nothing until it is compiled into bat's binary cache -- and that
# cache is keyed to the bat version that wrote it, so an upgrade silently drops
# back to the stock theme. brew-post-install.d/bat rebuilds it, which is why bat
# needs declaring here at all: hooks only run for formulae in this file. Was
# installed on this machine but never declared, same story as jq above.
brew "bat"

brew "dnsmasq"

# Sourced by .zshrc.d/03.tools.zsh, which skips it quietly when this is not
# installed. Needs fzf, declared further down.
brew "forgit"

brew "gh"
brew "git"
brew "git-delta"
brew "gron"
brew "htmlq"
brew "hunk"
brew "lazygit"
brew "moreutils"
brew "mosh"
brew "neovim"
brew "shellcheck"
brew "tree"
brew "tuicr"
brew "watch"
brew "yq"
brew "worktrunk"

# worktrunk's picker falls back to a plain prompt without it, but the
# "custom" herdr plugin (~/.config/herdr/plugins/local/custom/) requires it
# outright.
brew "fzf"

# The `files` and `text` channels shell out to fd and bat, both declared above.
brew "television"

# herdr-plugin-workspace-manager ships no prebuilt binary: its bin/ entrypoint
# is a shim that lazily `cargo build --release`s itself on first real
# invocation (and again after any source change), failing hard with "cargo
# not found" otherwise. Confirmed missing on a fresh machine -- it only ever
# went unnoticed here because cargo already happened to be present.
brew "rust"

tap "wilbeibi/tap"
brew "wilbeibi/tap/catchup"
