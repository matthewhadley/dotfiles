brew "git-lfs"
brew "herdr"
brew "yazi"

# yazi shells out to ffmpeg for video file previews (thumbnail extraction).
# Not a hard dependency -- yazi runs fine without it, previews just don't
# render for video files.
brew "ffmpeg"

# Required by .config/herdr/install-plugins.sh, which already hard-fails
# without it on PATH -- was relied on but never actually declared anywhere.
brew "jq"

# uvx (from uv) is what vjeantet.palette's scripts/check-compat.sh uses to
# validate commands.json against its schema -- install-plugins.sh runs that
# script every time and aborts (set -e) if neither uvx nor check-jsonschema
# is on PATH, which also skips the `herdr server reload-config` at the end.
brew "uv"

# Referenced by .zshrc.d/00.env.zsh for FPATH, same story as jq above.
brew "zsh-completions"

