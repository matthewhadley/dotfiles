#!/bin/sh
# Refreshes the herdr sidebar's dotfiles ahead/behind token whenever the refs
# that token is derived from actually move. Symlinked to
# ~/.dotfiles/hooks/reference-transaction by `dotfiles deps`, so edits here
# take effect with no reinstall.
#
# Why a hook at all: herdr re-reads every repo's git status on a 1.5s tick
# (GIT_REMOTE_STATUS_REFRESH_INTERVAL), guarded by an mtime fingerprint, so
# ordinary repos keep accurate markers with no help. It can only do that for
# repos it can discover, and this one's work tree is $HOME, which git
# discovery never sees. The Space herdr does see is the landing worktree on
# `bare-repo`, so `main`'s ahead/behind has to be reported in as workspace
# metadata -- see dotfiles-status.sh.
#
# Why reference-transaction and not post-commit: it is the only hook that also
# catches a push (via the local refs/remotes/origin/main update -- git has no
# post-push) and a fetch, and it fires however the ref moved: the wrapper,
# lazygit, raw `git --git-dir=`, or an agent that never applied the AGENTS.md
# rule about using the wrapper.
#
# THE STATE FILTER MUST STAY FIRST. This hook also runs in the "preparing" and
# "prepared" states, where a non-zero exit ABORTS the transaction -- failing
# the commit or fetch outright. Only in "committed" is the exit status
# ignored, and only then do the refs actually hold their new values.
[ "$1" = committed ] || exit 0

# Breadcrumbs for the paths that otherwise look exactly like success. Three
# distinct failures -- herdr not resolvable, the CLI unable to reach the
# socket, the action erroring -- all used to end in `exit 0` with nothing
# written anywhere, which cost an afternoon to diagnose once already: a commit
# refreshed the sidebar and the next one silently did not, with no evidence in
# the plugin log, the server log, or git.
#
# Not a contradiction of "no log file of its own to grow or rotate" below.
# That is about the SUCCESS trail, which herdr already keeps and which would
# be one line per ref update forever. Only failures land here, and the cap
# bounds the one case that could still be noisy -- a herdr that stays down.
#
# A log, so XDG_STATE_HOME -- alongside the herdr, nvim, gh and yazi state
# already there, and nothing under it is tracked, which is what this wants.
# Not ~/.dotfiles: that is the bare repo's own directory, objects and refs, no
# place for a log. Not $HOME either, which IS the work tree, so a file there
# lands in the dotfiles repo's namespace.
#
# mkdir is inside bail() rather than out here: failures are rare, and the happy
# path should not pay for a directory it will never write to.
bail_log=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/reference-transaction.log

bail() {
  mkdir -p "${bail_log%/*}" 2>/dev/null
  printf '%s\t%s\trefs=%s\tppid=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${matched:-none}" "$PPID" \
    >> "$bail_log" 2>/dev/null
  if [ "$(wc -l < "$bail_log" 2>/dev/null || echo 0)" -gt 400 ]; then
    tail -n 200 "$bail_log" > "$bail_log.tmp" 2>/dev/null &&
      mv "$bail_log.tmp" "$bail_log" 2>/dev/null
  fi
  exit 0
}

# stdin is "<old-oid> <new-oid> <ref>" lines. Only the two refs the count is
# derived from are worth a refresh; AUTO_MERGE, the landing worktree's own
# bare-repo branch and anything else cost one grep.
#
# Read into a variable rather than piping straight to grep, so the refs that
# triggered a failed run can be named in the breadcrumb. stdin is a handful of
# lines.
matched=$(grep -E ' (refs/heads/main|refs/remotes/origin/main)$' \
  | awk '{print $3}' | paste -sd, -)
[ -n "$matched" ] || exit 0

# Resolved rather than assumed. A caller whose PATH lacks /opt/homebrew/bin --
# a tool shell that sources no profile, say -- would otherwise bail here with
# no trace; verified that a minimal PATH reproduces exactly that. HERDR_BIN_PATH
# is exported into every herdr pane, so it survives where PATH does not.
herdr_bin=$(command -v herdr 2>/dev/null) ||
  herdr_bin=${HERDR_BIN_PATH:-/opt/homebrew/bin/herdr}
[ -x "$herdr_bin" ] || bail "herdr-not-found:PATH=$PATH"

# Invoked as a plugin action rather than by running dotfiles-status.sh
# directly, for the audit trail: herdr records every action run with its exit
# code and captured stderr, so a refresh that silently does nothing can still
# be found afterwards --
#
#   herdr plugin log list --plugin custom --limit 5 \
#     | jq -c '.result.logs[] | {action_id, exit_code, stderr}'
#
# which a direct call would give no record of at all. One extra process, and
# nothing waits on either. The trail lives inside herdr, so it needs no log
# file of its own to grow or rotate; the blind spot is herdr being down, which
# is also the one case where there would be nothing useful to report.
#
# Run synchronously, not backgrounded. This used to be `( ... & )`, which
# detaches from job control but leaves the child in the hook's process group,
# so anything that reaps that group takes the reporter with it before it can
# reach the socket. A commit from a shell survived, because the shell outlives
# it. A push from lazygit did not: the hook ran and no invoke ever arrived --
# no plugin log entry, nothing in the server log. Reproduced exactly by killing
# the group the instant the hook returns.
#
# `setsid` does not fix it. The child still has to be forked and exec'd before
# it can leave the group, and it loses that race; verified, the reproduction
# still failed with a session of its own. Only not returning until the work is
# done is reliable.
#
# The cost that backgrounding was buying is not worth it: a local invoke takes
# ~10ms, measured, which is noise against a commit. alarm(2) caps the pathology
# the & was really there for -- a wedged or restarting server -- at 5s instead
# of forever. The alarm survives exec, so it bounds the herdr CLI, not perl.
#
# Output still closed: a child inheriting the hook's stdout can leave git
# waiting for EOF. stderr is captured rather than discarded, so a failed invoke
# can say why in the breadcrumb instead of vanishing; `2>&1 >/dev/null` in that
# order keeps stdout out of git's way while routing stderr to the substitution.
err=$(perl -e 'alarm 5; exec @ARGV' \
  "$herdr_bin" plugin action invoke custom.dotfiles-status 2>&1 >/dev/null)
rc=$?
[ "$rc" -eq 0 ] || bail "invoke-failed:rc=$rc:${err:-no-stderr}"
exit 0
