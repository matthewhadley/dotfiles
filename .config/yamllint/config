# yamllint's user-global config. Its resolution order, from the tool's own
# cli.py, is:
#
#   1. -c on the command line
#   2. $YAMLLINT_CONFIG_FILE
#   3. .yamllint / .yamllint.yaml / .yamllint.yml in the working directory
#   4. $XDG_CONFIG_HOME/yamllint/config, else this file
#
# A fallback, not a base layer: step 3 is an `elif` above step 4, so a project
# carrying its own .yamllint replaces this file wholesale instead of merging
# with it. A project that wants these rules as well as its own has to say
# `extends: default` and restate them.
#
# Step 3 reads the working directory and nothing else -- yamllint never walks
# up the tree looking for a config. The upward search to the nearest .yamllint
# is done by Neovim instead, in the yamllint_cwd helper in
# ~/.config/nvim/init.lua, which cds there before running the linter.

extends: default

rules:
  # A `# yaml-language-server: $schema=<url>` directive is one unbreakable
  # token and routinely runs past 80 columns. It cannot be wrapped either:
  # yaml-language-server parses that line to bind the schema, so breaking it
  # silently turns schema validation off -- losing real diagnostics to satisfy
  # a style rule.
  #
  # yamllint's own allow-non-breakable-words escape hatch does not cover it:
  # that exempts a line only when it holds no spaces past the indent, and this
  # one has several. So the limit itself has to move. 140 leaves headroom over
  # the 123-column directive in the herdr workspace-manager config -- a raw
  # githubusercontent schema URL is comfortably the longest line worth
  # tolerating -- while still catching genuinely runaway lines.
  line-length:
    max: 140

  # Not wanted. These are single-document config files, and nothing that reads
  # them requires the marker.
  document-start: disable
