
# No font-family. Ghostty's built-in default is JetBrains Mono, embedded in the
# binary, and it embeds Symbols Nerd Font 3.4.0 alongside it as a fallback --
# so Nerd Font glyphs render with nothing installed. Verified with
# `ghostty +show-face --cp=0xF09B`, which reports "Symbols Nerd Font".
#
# Neither embedded font appears in `ghostty +list-fonts` or anywhere on disk,
# which is why this looked for a while like the machine had no Nerd Font at all.

keybind = cmd+v=paste_from_clipboard

# Herdr forwarding shortcuts. Ghostty uses "super" for the macOS Command key.
keybind = super+arrow_left=text:\x02p
keybind = super+arrow_right=text:\x02n
# Workspace prev/next. Overrides Ghostty's own jump_to_prompt on these two,
# which is no loss inside Herdr: Herdr owns the scrollback, not Ghostty.
keybind = super+arrow_up=text:\x02u
keybind = super+arrow_down=text:\x02d
keybind = super+d=new_split:right
keybind = super+shift+d=text:\x02v
keybind = super+w=text:\x02x
keybind = super+t=text:\x02c
keybind = super+shift+t=text:\x02v
keybind = super+shift+arrow_left=text:\x02h
keybind = super+shift+arrow_right=text:\x02l

cursor-color = #5fafff
cursor-style = block
shell-integration-features = no-cursor
bell-features = no-title

macos-titlebar-proxy-icon = hidden
window-padding-x = 5


background = #151C23
foreground = #C2C2C2
selection-background = #474e91
selection-foreground = #f4f4f4

cursor-text = #ffffff
palette = 0=#929292
palette = 1=#e27373
palette = 2=#94b979
palette = 3=#ffba7b
palette = 4=#97bedc
palette = 5=#e1c0fa
palette = 6=#00988e
palette = 7=#C2C2C2
palette = 8=#bdbdbd
palette = 9=#ffa1a1
palette = 10=#bddeab
palette = 11=#ffdca0
palette = 12=#b1d8f6
palette = 13=#fbdaff
palette = 14=#1ab2a8
palette = 15=#ffffff

# Neovim search/replace: forward Cmd+Shift+F as F12 through Herdr.
keybind = super+shift+f=text:\x1b[24~

# Neovim buffer tabs: forward Ctrl+Left/Right as F9/F10 through Herdr.
# Ctrl+arrow cannot be forwarded as itself -- a modified arrow needs CSI-u to
# carry the modifier and Herdr drops those, so nvim sees nothing. F9/F10 are
# plain `\e[20~`/`\e[21~`, the same unmodified-F-key shape as F11/F12 below,
# which is the part of the range Herdr is known to forward. Verified working.
#
# The chord itself also had to be freed: Ctrl+Left/Right are macOS's "Move
# left/right a space" (symbolic hotkeys 79 and 81), so WindowServer consumed
# them before Ghostty ever saw the event. Both are now disabled in
# com.apple.symbolichotkeys; re-enabling either silently breaks these two.
keybind = ctrl+arrow_left=text:\x1b[20~
keybind = ctrl+arrow_right=text:\x1b[21~

# Cmd+Ctrl+Left/Right was forwarded here as F7/F8, for nvim window motion
# between the edit buffer and the neo-tree sidebar. Removed: the motion worked,
# but macOS beeped on every press regardless -- so something above Ghostty is
# also claiming the chord and finding nothing to do with it. Not hammerspoon,
# which taps only mouse events, and nothing is registered for Cmd+Ctrl+arrow in
# com.apple.symbolichotkeys, so what rings the bell was never pinned down.
#
# No replacement forward. <C-h>/<C-l> in nvim already move between those two
# windows and survive the chain as single control bytes, needing no rewrite
# here at all.

# zsh all-history fuzzy search: forward Ctrl+Shift+R as F7.
#
# The rewrite is not an optimisation, it is the only way the chord can exist.
# Shift is not encoded in a C0 control byte, so Ctrl+Shift+R and Ctrl+R are
# both 0x12 and zsh cannot tell them apart; distinguishing them needs CSI-u,
# which Herdr drops. Ghostty is the one layer that still sees the real chord,
# so it has to translate here or not at all.
#
# F7 rather than a free Ctrl+letter because there is no free Ctrl+letter: every
# one from A-Z is bound in zsh's emacs keymap except ^C, ^Z and ^X, the first
# two being terminal signals and the third a prefix. F7 is available because
# the Cmd+Ctrl+Left forward directly above gave it up.
#
# Ctrl+R keeps its own meaning -- fzf over this pane's history. This is the
# same search across every pane's file in ~/.history.d. See 00.history.zsh,
# which binds \e[18~ to the widget.
keybind = ctrl+shift+r=text:\x1b[18~

# Neovim project search/replace: forward Cmd+Shift+R as F11 through Herdr.
#
# Was F13 originally. Confirmed via a scratch nvim pane and `herdr pane
# send-keys`: F12 (used by the mapping above) fires correctly through
# Herdr's real keystroke pipeline, F13 never does, regardless of which
# physical key triggers it -- Herdr itself doesn't forward F13, unrelated to
# Ghostty, nvim, or any hotkey conflict on Cmd+Shift+R (also ruled out by
# testing Cmd+Shift+K, which failed identically). F11 was verified working
# the same way before switching to it.
keybind = super+shift+r=text:\x1b[23~
