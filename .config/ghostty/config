
keybind = cmd+v=paste_from_clipboard

# Herdr forwarding shortcuts. Ghostty uses "super" for the macOS Command key.
keybind = super+arrow_left=text:\x02p
keybind = super+arrow_right=text:\x02n
keybind = super+d=new_split:right
keybind = super+shift+d=text:\x02v
keybind = super+shift+t=text:\x02c
keybind = super+shift+arrow_left=text:\x02h
keybind = super+shift+arrow_right=text:\x02l

cursor-color = #5fafff
cursor-style = block
shell-integration-features = no-cursor
bell-features = no-title

macos-titlebar-proxy-icon = hidden
window-padding-x = 5


background = #151C23
foreground = #C2C2C2
selection-background = #474e91
selection-foreground = #f4f4f4

cursor-text = #ffffff
palette = 0=#929292
palette = 1=#e27373
palette = 2=#94b979
palette = 3=#ffba7b
palette = 4=#97bedc
palette = 5=#e1c0fa
palette = 6=#00988e
palette = 7=#C2C2C2
palette = 8=#bdbdbd
palette = 9=#ffa1a1
palette = 10=#bddeab
palette = 11=#ffdca0
palette = 12=#b1d8f6
palette = 13=#fbdaff
palette = 14=#1ab2a8
