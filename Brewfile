# Homebrew packages this configuration depends on. Install with:
#
#   brew bundle --file=~/Brewfile
#
# Not a dump of everything installed on this machine -- only the things some
# tracked config file would break without. `brew bundle dump` would capture the
# lot, including one-offs, and the point here is to record what the dotfiles
# actually need.

# Nerd Font glyphs for the terminal. ~/.config/ghostty/config selects
# "JetBrainsMono Nerd Font Mono" by name, and nvim draws private-use glyphs in
# neo-tree, lualine, bufferline, which-key and obsidian.nvim. Without this the
# font-family line silently falls back and those glyphs render as tofu.
cask "font-jetbrains-mono-nerd-font"
