[color]
	ui = true
[user]
	name = matthewhadley
	email = matthew.hadley@gmail.com
[init]
	defaultBranch = main
	templateDir = ~/.git-templates
[core]
	excludesfile = ~/.gitignore_global
	# Side-by-side only when there is room for two 80-column halves. git runs
	# the pager through `sh -c` and the pager's stdout is the terminal, so
	# tput reports the current pane width, re-checked on every invocation.
	# Not in the terafox feature: lazygit shares that and sizes its own panes.
	pager = delta $(test $(tput cols) -ge 160 && echo --side-by-side)
[delta]
	# Styling lives in the included file below.
	features = terafox
	# n/N to jump between files. Deliberately not in the feature itself:
	# delta's docs say navigate does not work inside lazygit, and the feature
	# is shared with lazygit's git.diffRenderers. Needs less >= 551.
	navigate = true
[include]
	# Defines the `terafox` delta feature, selected by [delta] above and by
	# lazygit's git.diffRenderers.
	path = ~/.config/git/delta-terafox.gitconfig
[includeIf "hasconfig:remote.*.url:git@*.apple.com:*/**"]
	path = ~/.gitconfig-corp
[difftool]
	prompt = false
[mergetool]
	prompt = false
[push]
	followTags = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
    rebase = true
[rerere]
    # Rebasing replays each commit separately, so one conflicting file can ask
    # the same question once per commit. Record each resolution and reapply it.
    enabled = true
[merge]
	# No merge.tool is set, deliberately. nvimdiff's four panes were more
	# clutter than help, and every alternative tried was worse for this repo:
	# lazygit's conflict panel cannot syntax-highlight (it renders the file
	# itself rather than through a pager), and any nvim-based tool is crippled
	# exactly when it is needed most -- nvim cannot load a config that does not
	# parse, and ~/.config/nvim/init.lua is the file that conflicts most often.
	#
	# So conflicts are resolved by editing the markers directly, which is what
	# conflictStyle below is for. `git mergetool` will prompt for a tool if it
	# is ever wanted for a one-off.
	#
	# zdiff3 adds the common ancestor to the markers. Without it a conflict is
	# just "mine" against "theirs", which is unreadable when one side moved or
	# reindented a region and the other inserted into it -- the same lines show
	# on both sides and nothing says who changed what. Note it means four
	# marker lines per conflict, not three: <<<<<<< ||||||| ======= >>>>>>>.
	conflictStyle = zdiff3
[alias]
	logs = log --pretty=format:'%C(yellow bold)%h%Creset - %s %C(white)%cr by %an%Creset'
