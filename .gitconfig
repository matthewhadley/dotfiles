[color]
	ui = true
[user]
	name = matthewhadley
	email = matthew.hadley@gmail.com
[init]
	defaultBranch = main
	templateDir = ~/.git-templates
[core]
	excludesfile = ~/.gitignore_global
	pager = delta
[delta]
	# Styling lives in the included file below.
	features = terafox
	# n/N to jump between files. Deliberately not in the feature itself:
	# delta's docs say navigate does not work inside lazygit, and the feature
	# is shared with lazygit's git.diffRenderers. Needs less >= 551.
	navigate = true
[include]
	# Defines the `terafox` delta feature, selected by [delta] above and by
	# lazygit's git.diffRenderers.
	path = ~/.config/git/delta-terafox.gitconfig
[includeIf "hasconfig:remote.*.url:git@*.apple.com:*/**"]
	path = ~/.gitconfig-corp
[difftool]
	prompt = false
[mergetool]
	prompt = false
[push]
	followTags = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = false
[diff]
	tool = nvimdiff
[merge]
	tool = nvimdiff
[alias]
	logs = log --pretty=format:'%C(yellow bold)%h%Creset - %s %C(white)%cr by %an%Creset'
