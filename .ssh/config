# ~/.ssh/config

# exclude hosts config from source control
Include hosts

# forward ssh keys in local network
Host                192.168.0.*
ForwardAgent        yes

# github over 443. Port 22 is blocked in the agent sandbox -- `connect to host
# github.com port 22: Operation not permitted` -- so every push and fetch from
# a Claude Code session failed, while the same command worked from a terminal.
# ssh.github.com:443 is GitHub's own documented alternate endpoint, serving the
# same host keys and the full git protocol, so this is transparent everywhere
# else. Must stay above `Host *`: ssh takes the first value it finds for a
# keyword, not the last.
Host                github.com
Hostname            ssh.github.com
Port                443

# don't trust external machines with ssh keys
Host                *
ForwardAgent        no
AddKeysToAgent      yes
UseKeychain         yes
