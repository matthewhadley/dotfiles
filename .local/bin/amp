#!/bin/zsh

# Control Amphetamine sessions, including closed-lid sleep prevention.
# amp toggles; amp MINUTES starts a fresh timed session.
#
# "off" quits Amphetamine instead of just ending the session, so its menu
# bar icon disappears with the process (macOS only shows a status item while
# its owning app is running -- there's no supported way to hide it
# independent of that). Two real tradeoffs versus just ending the session:
#
#   - Trigger-based auto-start (Amphetamine's own condition-driven sessions)
#     stops working while the app is quit -- nothing is running to watch for
#     those conditions.
#   - A cold `tell application "Amphetamine"` launch takes a moment before
#     the app is actually up and closed-lid mode is re-enabled. Starting a
#     session and immediately closing the lid risks the Mac beginning to
#     sleep before that assertion lands. Fine if sessions are normally
#     started from a stable, lid-open state; risky otherwise.
#
# `application "Amphetamine" is running` (used below) is the one AppleScript
# check that never launches the app, unlike any `tell application` block or
# property/command access -- without it, even a plain `amp status` would
# resurrect the icon on a quit app, defeating the point.
if [[ "$OSTYPE" != darwin* ]]; then
  print -u2 'amp: macOS only (needs osascript and the Amphetamine app).'
  exit 1
fi

action=${1:-toggle}
[[ "$action" == "-s" ]] && action=status

if (( $# > 1 )); then
  print -u2 'Usage: amp [on|off|status|-s|MINUTES]'
  exit 2
fi

case "$action" in
  toggle|on|off|status) ;;
  <->)
    if [[ "$action" != *[1-9]* ]]; then
      print -u2 'amp: MINUTES must be a positive integer.'
      exit 2
    fi
    ;;
  *)
    print -u2 'Usage: amp [on|off|status|-s|MINUTES]'
    exit 2
    ;;
esac

exec /usr/bin/osascript - "$action" <<'APPLESCRIPT'
on run argv
  set action to item 1 of argv
  set minuteCount to 0
  if action is not in {"toggle", "on", "off", "status"} then
    set minuteCount to action as integer
    if minuteCount < 1 then error "MINUTES must be a positive integer."
    set action to "timed"
  end if

  set appRunning to application "Amphetamine" is running

  if action is "status" then
    if not appRunning then return "Amphetamine: off"
    tell application "Amphetamine"
      if not (session is active) then return "Amphetamine: off"
      set remainingSeconds to session time remaining
      if remainingSeconds is -3 then return "Amphetamine: off"
      if remainingSeconds > 0 then
        set remainingMinutes to remainingSeconds div 60
        set extraSeconds to remainingSeconds mod 60
        set timerText to (remainingMinutes as text) & "m " & (extraSeconds as text) & "s remaining"
      else if remainingSeconds is 0 then
        set timerText to "indefinite"
      else if remainingSeconds is -1 then
        set timerText to "Trigger-based"
      else if remainingSeconds is -2 then
        set timerText to "app/date-based; timer unavailable"
      else
        set timerText to "timer unavailable"
      end if
      set closedMode to closed display mode enabled
      return "Amphetamine: on; " & timerText & "; closed-lid sleep prevention: " & (closedMode as text)
    end tell
  end if

  if action is "toggle" then
    if not appRunning then
      set action to "on"
    else
      tell application "Amphetamine"
        if session is active then
          set action to "off"
        else
          set action to "on"
        end if
      end tell
    end if
  end if

  if action is "off" then
    -- Already not running: already off, and no session to have addressed.
    if not appRunning then return "Amphetamine: off"
    tell application "Amphetamine"
      end session
      set stillActive to session is active
    end tell
    if stillActive then return "Session still active; check Amphetamine Triggers."
    -- Removing the icon needs the process gone, and Amphetamine ignores the
    -- standard AppleScript `quit` command -- confirmed live: it returns
    -- success with no error, but the PID never changes. `killall` sends a
    -- real signal instead, bypassing whatever swallows the Apple Event.
    do shell script "killall Amphetamine"
    return "Amphetamine: off"
  end if

  -- "on" or "timed": `tell application` launches Amphetamine automatically
  -- if it isn't running, and AppleScript waits for that synchronously
  -- before the next line runs -- no explicit launch/wait step needed here.
  tell application "Amphetamine"
    if action is "timed" then
      start new session with options {duration:minuteCount, interval:minutes, displaySleepAllowed:true}
    else if not (session is active) then
      start new session with options {duration:0, interval:0, displaySleepAllowed:true}
    end if

    if not (closed display mode enabled) then enable closed display mode
    set closedMode to closed display mode enabled
    if action is "timed" then
      return "Amphetamine: on for " & (minuteCount as text) & " minutes; closed-lid sleep prevention: " & (closedMode as text)
    end if
    return "Amphetamine: on; closed-lid sleep prevention: " & (closedMode as text)
  end tell
end run
APPLESCRIPT
