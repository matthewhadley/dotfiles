#!/bin/zsh

_dotfiles_git_home() {
  git -C "$HOME" --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"
}

_dotfiles_scopes_scan() {
  # Derive the vocabulary from history rather than a list that has to be kept
  # in step by hand. Bootstrap a new machine with:
  #
  #   dotfiles scopes rebuild
  #
  # Two commits are skipped for the same reasons the hook exempts them: special
  # commits are not required to carry a scope, and subjects with no colon
  # cannot have one. Anything that does not match the hook's own scope charset
  # is dropped too, which is what keeps leftover Conventional Commit subjects
  # like "feat(nvim): ..." from contributing a scope of "feat(nvim)".
  local -a found
  local subjects subject scope s
  subjects=$(_dotfiles_git_home log --format=%s) || return
  while IFS= read -r subject; do
    [[ $subject =~ '^(Merge|Revert|fixup!|squash!|amend!)' ]] && continue
    [[ $subject != *:* ]] && continue
    scope=${subject%%:*}
    scope=${scope%% \(*}
    for s in ${(s:,:)scope}; do
      s=${s## }
      s=${s%% }
      [[ $s =~ '^[a-z0-9._/-]+$' ]] && found+=$s
    done
  done <<< "$subjects"
  (( ${#found} )) || return 1
  echo ${(j: :)${(o)${(u)found}}}
}

_dotfiles_scopes() {
  # The scope vocabulary the commit-msg hook enforces. Lives in git config,
  # which for this repo means ~/.dotfiles/config -- inside the git dir, so it
  # is NOT tracked and a fresh clone starts with no vocabulary at all. Run
  # `dotfiles scopes rebuild` as part of bootstrapping a new machine.
  local -a current
  # --get-all to match the hook: --get returns only the last value, so a
  # multi-valued key would list short of what is actually enforced.
  current=(${(s: :)"$(_dotfiles_git_home config --get-all scopedcommits.scopes)"})

  local verb="$1"
  [[ -n $verb ]] && shift

  case "$verb" in
    "")
      if (( ${#current} == 0 )); then
        echo "no scopes configured -- the hook accepts any scope"
        echo "set them with: dotfiles scopes set <name> [name...]"
        return 1
      fi
      echo "${current[*]}"
      return
      ;;
    scan)
      _dotfiles_scopes_scan
      return
      ;;
    rebuild)
      (( $# == 0 )) || { echo "usage: dotfiles scopes rebuild"; return 2 }
      local scanned
      scanned=$(_dotfiles_scopes_scan) || {
        echo "could not rebuild scopes from history; configured scopes unchanged" >&2
        return 1
      }
      current=(${(s: :)scanned})
      ;;
    add)
      (( $# )) || { echo "usage: dotfiles scopes add <name> [name...]"; return 2 }
      # -U dedupes, so adding one that is already there is a no-op rather than
      # a duplicate entry.
      current=(${(u)current[@]} "$@")
      ;;
    rm)
      (( $# )) || { echo "usage: dotfiles scopes rm <name> [name...]"; return 2 }
      local name
      for name in "$@"; do
        if [[ ${current[(Ie)$name]} -eq 0 ]]; then
          echo "not a configured scope: $name"
          return 1
        fi
        current=(${current:#$name})
      done
      ;;
    set)
      (( $# )) || { echo "usage: dotfiles scopes set <name> [name...]"; return 2 }
      current=("$@")
      ;;
    *)
      echo "usage: dotfiles scopes [scan|rebuild|add|rm|set <name>...]"
      return 2
      ;;
  esac

  current=(${(o)${(u)current[@]}})
  _dotfiles_git_home config --replace-all scopedcommits.scopes "${current[*]}" || return
  echo "scopes: ${current[*]}"
}

_dotfiles_list() {
  local -A st
  local line f

  while IFS= read -r line; do
    st[${line:3}]="${line:0:2}"
  done < <(_dotfiles_git_home status --porcelain)

  _dotfiles_git_home ls-files | while IFS= read -r f; do
    printf '%s\t~/%s\t%s\n' "${st[$f]:-  }" "$f" "$(_dotfiles_git_home log -1 --format='%s' -- "$f")"
  done | column -t -s $'\t'
}

_dotfiles_check() {
  local branch remote ahead behind staged unstaged untracked line msg
  local -a changes
  branch="$(_dotfiles_git_home branch --show-current)" || return
  remote="${1:-origin}"

  if [[ -z $branch ]]; then
    echo "dotfiles not on a branch"
    return 1
  fi

  _dotfiles_git_home fetch "$remote" "${branch}:refs/remotes/${remote}/${branch}" || return

  read -r ahead behind < <(_dotfiles_git_home rev-list --left-right --count "${branch}...${remote}/${branch}") || return
  staged=0
  unstaged=0
  untracked=0

  while IFS= read -r line; do
    [[ -z $line ]] && continue
    changes+=("$line")
    if [[ ${line:0:2} == "??" ]]; then
      (( untracked++ ))
      continue
    fi
    [[ ${line:0:1} != " " ]] && (( staged++ ))
    [[ ${line:1:1} != " " ]] && (( unstaged++ ))
  done < <(_dotfiles_git_home status --porcelain=v1)

  if (( ahead == 0 && behind == 0 )); then
    msg="dotfiles up-to-date with $remote/$branch"
  elif (( ahead > 0 && behind == 0 )); then
    msg="dotfiles ahead of $remote/$branch by $ahead commit(s)"
  elif (( ahead == 0 && behind > 0 )); then
    msg="dotfiles behind $remote/$branch by $behind commit(s)"
  else
    msg="dotfiles diverged from $remote/$branch; ahead $ahead, behind $behind"
  fi

  echo "$msg"

  if (( staged > 0 || unstaged > 0 || untracked > 0 )); then
    echo "local changes: staged $staged, unstaged $unstaged, untracked $untracked"
    printf '%s\n' "${changes[@]}"
  fi
}

_dotfiles_logs() {
  # The global `git logs` alias (~/.gitconfig) ends every line with " by %an".
  # In this repo that is always the same person, so drop it -- but only here;
  # the alias stays as-is for every other repo. Format is otherwise identical to
  # the alias. Plain `dotfiles log` is still unmodified `git log`; this is the
  # shorthand. Extra args pass through, and --oneline/--pretty/--format step it
  # aside.
  local arg
  for arg in "$@"; do
    case $arg in
      --oneline|--pretty|--pretty=*|--format|--format=*)
        _dotfiles_git_home log "$@"
        return
        ;;
    esac
  done
  _dotfiles_git_home log \
    --pretty='format:%C(yellow bold)%h%Creset - %s %C(white)%cr%Creset' \
    "$@"
}

_dotfiles_hunk() {
  # Hunk locates a repo the way git does, so GIT_DIR/GIT_WORK_TREE is all it
  # needs -- and unlike -C "$HOME", it leaves the cwd alone, so pathspecs still
  # resolve against wherever the caller is standing.
  #
  # --exclude-untracked is not a preference here. Hunk lists untracked files
  # with `git ls-files --others`, which does not consult
  # status.showUntrackedFiles, so without it every review would walk the half
  # million files under $HOME. Only `hunk diff` takes the flag, and it has to
  # go before any `--` pathspec, so it is spliced in rather than appended.
  local -a args
  args=("$@")
  # Bare, or starting with a flag or a `--` pathspec, means a working tree
  # review -- so `hunk --staged` and `hunk -- .config` reach hunk as diff
  # subcommands rather than as a missing one.
  [[ ${args[1]} == (|-*) ]] && args=(diff "${args[@]}")
  [[ ${args[1]} == diff ]] && args=(diff --exclude-untracked "${args[@]:1}")
  GIT_DIR="$HOME/.dotfiles" GIT_WORK_TREE="$HOME" hunk "${args[@]}"
}

_dotfiles_lazygit() {
  # lazygit refuses a bare repo outright -- "Lazygit does not support bare
  # repos" -- but its own error text names the way through: pass --git-dir and
  # --work-tree, the same pair the git fallback at the bottom of this file
  # uses.
  #
  # Deliberately the flags rather than the GIT_DIR/GIT_WORK_TREE pair
  # _dotfiles_hunk sets. Both reach git the same way in the end, but the flags
  # are what lazygit documents for this case, and they stay scoped to lazygit
  # rather than being inherited by every editor and custom command it spawns.
  #
  # Untracked files are the same hazard here that they are for hunk -- $HOME
  # holds half a million of them. Nothing has to be spliced in though: lazygit
  # reads status.showUntrackedFiles and forwards it as --untracked-files, and
  # ~/.dotfiles/config sets it to `no`, so the Files panel stays tracked-only.
  lazygit --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"
}

_dotfiles_serie() {
  # Serie's git subprocesses inherit the repo paths. Keep its working
  # directory at the work tree root without moving the caller's shell.
  ( cd -- "$HOME" \
    && GIT_DIR="$HOME/.dotfiles" GIT_WORK_TREE="$HOME" serie "$@" )
}

_dotfiles_forgit() {
  # forgit ships as an executable called `git-forgit`, which git runs as the
  # subcommand `git forgit`. So this is that, with the repo paths set -- the
  # same pair _dotfiles_hunk exports, and the cwd is left alone for the same
  # reason: pathspecs still resolve against wherever the caller is standing.
  # Bare `dotfiles forgit` prints forgit's own list of commands.
  #
  # Untracked files are not a hazard here, unlike hunk: forgit reads changes
  # through `git status` and `git diff`, which honour status.showUntrackedFiles,
  # so it stays tracked-only. The flip side is that `forgit add` cannot stage a
  # brand-new file -- that still takes `dotfiles add <path>`.
  #
  # The graph is switched off for a filtered log -- -S, -G, or a `--` pathspec
  # on `log`. A filter that skips commits makes `git log --graph` print bare
  # "..." rows, fzf treats those as selectable, and selecting one gives "fatal:
  # bad revision ''". Unfiltered, there are no gaps and the graph stays.
  if ! command -v git-forgit >/dev/null 2>&1; then
    echo "dotfiles: forgit is not installed (brew install forgit)" >&2
    return 1
  fi
  local arg
  if [[ $1 == log ]]; then
    for arg in "${@:2}"; do
      if [[ $arg == (-S*|-G*|--) ]]; then
        local -x FORGIT_LOG_GRAPH_ENABLE=false
        break
      fi
    done
  fi
  GIT_DIR="$HOME/.dotfiles" GIT_WORK_TREE="$HOME" git forgit "$@"
}

_dotfiles_brew() {
  # `brew bundle` has no post-install hook, and formulae that need one-time
  # setup after installing (catchup's `install-skill` commands, say) have
  # nowhere else to declare that. brew-post-install.d/<formula> covers it
  # generically: drop an executable there named after the formula -- the
  # short name, not tap-qualified (`catchup`, not `wilbeibi/tap/catchup`) --
  # and it runs automatically whenever that formula's line in `brew bundle
  # install`'s own output says "Installing" or "Upgrading". "Using" (already
  # current) is skipped, so re-running this doesn't redo one-time setup on
  # every call -- only when the formula's contents actually just changed.
  local brewfile="$HOME/.config/dotfiles/Brewfile"
  local post_install_dir="$HOME/.config/dotfiles/brew-post-install.d"
  local line name script

  brew bundle install --verbose --file "$brewfile" | while IFS= read -r line; do
    print -r -- "$line"
    case "$line" in
      "Installing "*|"Upgrading "*)
        name="${${line#* }:t}"
        script="$post_install_dir/$name"
        [[ -x "$script" ]] && { print -r -- "==> post-install: $name"; "$script" }
        ;;
    esac
  done
  return "${pipestatus[1]}"
}

_dotfiles_hooks() {
  # Hooks live in the git dir, which is not tracked, so each machine has to
  # grow its own copy from the tracked source. Symlinked rather than copied so
  # editing the tracked file takes effect at once, with no reinstall step to
  # forget and no second copy to drift.
  #
  # Only reference-transaction is managed here. commit-msg is left alone: it
  # arrives from ~/.git-templates/hooks at clone time, and is shared with every
  # other repo on the machine.
  #
  # Nothing is linked on a machine without herdr. The hook exists solely to
  # refresh a herdr sidebar token, and it already no-ops on its own when herdr
  # is missing -- but a hook that cannot do anything is still a hook in the
  # path of every commit and fetch in $HOME, and this repo is not one to leave
  # inert machinery lying in.
  #
  # Skipped rather than unlinked, deliberately. herdr briefly off PATH -- a
  # login shell that has not sourced it, a half-finished brew upgrade -- would
  # otherwise make `deps` tear out a hook that was working fine.
  if ! command -v herdr >/dev/null 2>&1; then
    echo "herdr not installed; skipping reference-transaction hook"
    return 0
  fi
  local src="$HOME/.config/dotfiles/hooks"
  local dst="$HOME/.dotfiles/hooks"
  local hook
  [[ -d $dst ]] || mkdir -p "$dst"
  for hook in reference-transaction; do
    if [[ ! -r $src/$hook ]]; then
      echo "missing tracked hook: $src/$hook" >&2
      return 1
    fi
    ln -sfn "$src/$hook" "$dst/$hook" || return 1
    echo "linked $dst/$hook -> $src/$hook"
  done
}

_dotfiles_herdr_reload() {
  # install-plugins.sh reconciles plugins; nothing was reloading config.toml,
  # so tracked sidebar/keybinding changes sat inert until the next server
  # start -- easy to mistake for the change not working.
  #
  # Skipped rather than failed when no server is running: config.toml is read
  # at startup, so there is nothing to reload and nothing wrong. `status
  # server` is the check; a stale socket left by a crash makes it fail the same
  # way an absent one does.
  if ! herdr status server >/dev/null 2>&1; then
    echo "no herdr server running; config.toml applies at next start"
    return 0
  fi
  # Diagnostics are printed, not swallowed. A bad ui block reloads as
  # "partial" -- the server keeps its current settings and says why, which is
  # the one outcome worth seeing here.
  local out
  out=$(herdr server reload-config 2>&1) || {
    echo "$out" >&2
    return 1
  }
  printf '%s\n' "$out" | jq -r '
    "config reload: " + (.result.status // "unknown"),
    (.result.diagnostics // [])[]
  '
}

_dotfiles_deps() {
  # One entrypoint for everything this machine's package/plugin state depends
  # on. brew and herdr each reconcile differently -- brew bundle diffs the
  # Brewfile itself, herdr has no declarative manifest so install-plugins.sh
  # is the record of intent (see its own header) -- so this just sequences
  # the two rather than unifying their logic. Brew runs first: install-plugins.sh
  # hard-fails without jq on PATH, and jq is a Brewfile formula.
  local herdr_script="$HOME/.config/herdr/install-plugins.sh"
  _dotfiles_brew || return
  echo
  echo "==> herdr plugins"
  "$herdr_script"
  echo
  echo "==> git hooks"
  _dotfiles_hooks
  echo
  echo "==> herdr config"
  _dotfiles_herdr_reload
}

_dotfiles_resolve() {
  # Open the conflicted files of an in-progress merge or rebase in diffview.
  #
  # diffview shells out to git like everything else, so the GIT_DIR/GIT_WORK_TREE
  # pair _dotfiles_hunk sets is all it needs to find the bare repo -- there is no
  # flag equivalent the way lazygit has one. The subshell cd to $HOME makes nvim's
  # cwd the work tree so diffview's paths and the file panel agree, same reasoning
  # as `dotfiles edit`.
  #
  # Mid-rebase, "ours" is upstream and "theirs" is the commit being replayed --
  # backwards from a merge, because rebase checks out the upstream base and
  # replays your commits onto it. <leader>cb takes both, which is what most of
  # these conflicts want.
  #
  # A conflict in a git config file is its own trap: git parses those before it
  # does anything, so while one holds conflict markers EVERY git command fails --
  # the check below, and everything diffview would run. Only a plain editor can
  # get out of that, so say so rather than opening a diffview that cannot work.
  local out
  if ! out=$(_dotfiles_git_home diff --name-only --diff-filter=U 2>&1); then
    print -u2 -- "dotfiles: git cannot run: $out"
    if [[ $out == *"bad config line"* ]]; then
      print -u2 -- "dotfiles: conflict markers in a git config file break every git"
      print -u2 -- "dotfiles: command. Clear them in a plain editor first, then retry."
    fi
    return 1
  fi
  if [[ -z $out ]]; then
    print -- "dotfiles: nothing conflicted"
    return 0
  fi
  print -- "dotfiles: ${#${(f)out}} conflicted:"
  print -- "  ${(pj:\n  :)${(f)out}}"
  ( cd -- "$HOME" \
    && GIT_DIR="$HOME/.dotfiles" GIT_WORK_TREE="$HOME" nvim "+DiffviewOpen" "$@" )
}

_dotfiles_help() {
  cat <<'EOF'
dotfiles git bare repo management at ~/.dotfiles

  edit, nvim, nv open Neovim showing only the tracked files, as a tree
  list           every tracked file, its status, and the last commit to touch it
  check          fetch, then report ahead/behind and any local changes
  brew           brew bundle install from .config/dotfiles/Brewfile, then run
                 any matching .config/dotfiles/brew-post-install.d/<formula>
  deps           brew, then herdr's install-plugins.sh, then link this repo's
                 git hooks and reload herdr's config -- everything this
                 machine's package/plugin state depends on, in one call
  hunk           open the changes in Hunk; bare `hunk` is the working tree,
                 otherwise the args are a hunk command (`hunk --staged`,
                 `hunk show HEAD~1`, `hunk diff -- .config/ghostty`)
  lazygit        open the repo in lazygit, which needs the git-dir/work-tree
                 pair spelled out -- it refuses a bare repo on its own
  serie          open the commit graph in Serie; extra arguments pass through
  forgit         run a forgit picker on the repo -- `forgit log`, `forgit add`,
                 `forgit diff`; extra arguments pass through, and bare `forgit`
                 lists the commands
  logs           the `git logs` alias without the redundant " by <author>"
  resolve        open the conflicted files of a merge or rebase in diffview
  scopes         list the commit scopes the hook allows; scan/rebuild/add/rm/set
                 rebuild replaces configured scopes with those in HEAD's history
  help           this text

Agents: read ~/.github/AGENTS.md before working in this repo.
EOF
}

case "$1" in
  help|--help|-h|"")
    _dotfiles_help
    ;;
  list)
    shift
    _dotfiles_list "$@"
    ;;
  check)
    shift
    _dotfiles_check "$@"
    ;;
  brew)
    shift
    _dotfiles_brew "$@"
    ;;
  deps)
    shift
    _dotfiles_deps "$@"
    ;;
  logs)
    shift
    _dotfiles_logs "$@"
    ;;
  hunk)
    shift
    _dotfiles_hunk "$@"
    ;;
  lazygit)
    shift
    _dotfiles_lazygit "$@"
    ;;
  serie)
    shift
    _dotfiles_serie "$@"
    ;;
  forgit)
    shift
    _dotfiles_forgit "$@"
    ;;
  resolve)
    shift
    _dotfiles_resolve "$@"
    ;;
  scopes)
    shift
    _dotfiles_scopes "$@"
    ;;
  nvim|edit|nv)
    shift
    # The neo-tree source resolves the repo itself, so this does not need to
    # run from $HOME -- but cd'ing there makes nvim's cwd the work tree, so
    # telescope, :Neotree filesystem and the paths in the tabline all agree
    # with the tree's own root. The subshell leaves the calling shell's cwd
    # alone, same as nv does for a directory.
    #
    # DOTFILES_EDIT tells init.lua to scope <leader>ff and <leader>fg to the
    # bare repo's tracked files -- from $HOME they would otherwise walk every
    # untracked file in the home directory.
    ( cd -- "$HOME" && DOTFILES_EDIT=1 nvim "+Neotree dotfiles left" "$@" )
    ;;
  *)
    # Two -c overrides, and deliberately not -C "$HOME".
    #
    # status.relativePaths=false prints paths from the work tree root, so
    # `dotfiles status` in a subdirectory shows `.editorconfig` rather than
    # `../../../.editorconfig`. That is what -C "$HOME" was achieving, but -C
    # also resolves pathspecs against $HOME, which broke
    # `cd ~/.config/ghostty && dotfiles add config`. This fixes the display
    # without moving the working directory. Nothing was ever hidden by either:
    # git status always reports the whole repo.
    #
    # advice.statusHints=false drops git's parenthetical "(use ...)" hints.
    # With showUntrackedFiles off, every clean status otherwise ends with
    # "(use -u to show untracked files)".
    #
    # Passed with -c rather than set in config so plain git is unaffected and
    # there is no extra machine-local step -- ~/.dotfiles/config is untracked.
    git -c status.relativePaths=false -c advice.statusHints=false \
      --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"
    ;;
esac
