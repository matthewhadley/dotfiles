#!/bin/sh
# hunk-branch-diff — review what this branch changes, rather than what is
# uncommitted.
#
# Runs in the "branch" tab of the standard herdr layout, alongside the "hunk"
# tab's plain `hunk diff --watch`. The two are deliberately complementary:
#
#   hunk    the working tree -- what you have not committed yet
#   branch  merge-base..HEAD -- what the branch adds on top of its base
#
# ── Why the merge base, and not just the base branch ────────────────────────
#
# `git diff main` compares the two tips, so anything that landed on main after
# you branched shows up inverted, as though you had deleted it:
#
#   git diff main         ->  f | 1 +   other | 1 -    <- you never touched other
#   git diff main...HEAD  ->  f | 1 +
#
# Three-dot is shorthand for "diff against the merge base", which is where the
# branch actually diverged and what the forge shows on a pull request. hunk
# honours the dots the same way git does, so the range is handed to it whole
# rather than resolved here -- see the note above the exec.
#
# Note the same distinction does NOT apply to commit ranges: `git log A..B` and
# tuicr's `-r A..B` already mean "reachable from B, not from A", so two dots is
# correct there. It is only `git diff` where the dots change the answer.
#
# ── Finding the base branch ─────────────────────────────────────────────────
#
# origin/HEAD, which is the remote's own default branch rather than a guess at
# `main`. Set by `git clone`, and inherited by every linked worktree of that
# clone -- verified present in each repo on this machine. When it is missing
# (some bare setups, or a remote added by hand) `git remote set-head origin -a`
# writes it with one network call.
set -eu

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "hunk-branch-diff: not a git repository: $PWD" >&2
  exit 1
fi

base=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null || true)
if [ -z "$base" ]; then
  echo "hunk-branch-diff: origin/HEAD is not set; run: git remote set-head origin -a" >&2
  echo "hunk-branch-diff: falling back to the working tree" >&2
  exec hunk diff --watch
fi

mb=$(git merge-base "$base" HEAD 2>/dev/null || true)
if [ -z "$mb" ]; then
  echo "hunk-branch-diff: no merge base with $base; falling back to the working tree" >&2
  exec hunk diff --watch
fi

# Three dots, and refs rather than the merge base this script just resolved.
#
# hunk honours the dots the way git does -- verified on a branch whose base had
# moved: `hunk diff main` and `hunk diff main..HEAD` both report the base's own
# new file as a deletion, `hunk diff main...HEAD` does not. So the range can be
# handed over symbolically instead of resolving it here.
#
# That matters because the pane outlives the command. `--watch` re-reads, but
# arguments are fixed at launch, so a resolved SHA freezes the comparison at
# whatever the branch point was when the tab opened. Rebase onto a moved base --
# routine while a PR is open -- and the pane goes on diffing from the old point:
# observed showing 37 commits and +1189/-211 for a branch that was one commit
# ahead. Passing refs lets every reload resolve them afresh.
#
# The merge base is still computed above, but only to decide between this and
# the fallbacks; it is not what gets compared.
exec hunk diff "$base...HEAD" --watch
